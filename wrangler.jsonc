{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-round-coordinator",
  "compatibility_date": "2026-09-13",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app is one page with client-side tabs, so any unmatched path serves
    // index.html — except /api/*, which must reach the Worker instead.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-coordinator",
      "database_id": "505406d3-dc0a-4e94-ae30-17a295a506db"
    }
  ],
  // Once a minute, so the Worker can follow a tournament's draw on its own.
  // Almost every firing is a no-op: the handler asks whether any tournament has
  // an open watch window and returns immediately when none has, which is the
  // case except during an event somebody has armed.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Wrangler creates the DNS record for this hostname on deploy, provided the
  // englandbb.co.uk zone sits on the same Cloudflare account.
  "routes": [
    {
      "pattern": "coordinator.englandbb.co.uk",
      "custom_domain": true
    }
  ]
}
